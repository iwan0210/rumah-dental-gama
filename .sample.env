# =========================================================
# Example Environment Configuration
#
# Copy this file to ".env" and adjust the values according
# to your environment before running the application.
# =========================================================

# =========================================================
# Application
# =========================================================
HOST=localhost
PORT=3000
TZ=Asia/Jakarta

# =========================================================
# Database
# =========================================================
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASS=your_mysql_password
MYSQLDB=your_database_name

# =========================================================
# Authentication
# =========================================================
ACCESS_TOKEN_SECRET=your_access_token_secret
SESSION_SECRET=your_session_secret

# =========================================================
# Third Party - Fonnte.com
# =========================================================
WHATSAPP_TOKEN=your_whatsapp_token

# =========================================================
# Clinic Information
# These values are displayed throughout the application.
# Change them according to your clinic.
# =========================================================
APP_NAME=Your Clinic Name
APP_SHORT_NAME=Your Clinic

APP_ADDRESS=Your Clinic Address
APP_PHONE=081234567890

# Google Maps Embed URL (iframe)
APP_GOOGLE_MAPS_EMBED=https://www.google.com/maps?q=-6.9140944,109.732091&hl=id&z=20&output=embed

# Google Maps Share URL
APP_GOOGLE_MAPS_URL=https://maps.app.goo.gl/example