<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <!--begin::Primary Meta Tags-->
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="title" content="<%= app.name %> | Pendaftaran Online" />
  <meta name="author" content="<%= app.name %>" />
  <meta name="description"
    content="Pendaftaran online <%= app.name %>. Permudah pendaftaran pemeriksaan gigi, pilih jadwal, dan dapatkan pelayanan yang cepat serta nyaman." />
  <meta name="keywords"
    content="pendaftaran online, klinik gigi, dokter gigi, pemeriksaan gigi, <%= app.shortName %>, <%= app.name %>, booking dokter gigi" />
  <!--end::Primary Meta Tags-->
  <title><%= app.name %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
    }
    header {
      background-color: #007bff;
      color: white;
      padding: 1rem 0;
    }
    footer {
      background-color: #f8f9fa;
      padding: 1rem 0;
      margin-top: 2rem;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="text-center">
    <h1><%= app.name %></h1>
    <p>Perawatan Gigi Profesional dan Ramah</p>
  </header>

  <!-- Main Content -->
  <main class="container my-5">
    <section class="text-center">
      <h2>Selamat Datang di <%= app.name %></h2>
      <p>Kami menyediakan layanan perawatan gigi terbaik dengan petugas berpengalaman dan fasilitas modern.</p>

      <!-- Tombol Daftar -->
      <a href="/register" class="btn btn-primary btn-lg my-3">Daftar Sekarang</a>
    </section>

    <!-- Gambar Gedung -->
    <div class="text-center my-4">
      <img src="/images/foto-gedung.jpg" alt="Gedung Klinik Dental Gama" class="img-fluid rounded shadow" style="max-height: 400px;">
    </div>

    <!-- Peta Lokasi -->
    <section class="my-5">
      <h4 class="text-center">Lokasi Klinik</h4>
      <div class="ratio ratio-16x9 mb-3">
        <iframe
          src="<%= app.maps.embedUrl %>"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
      <div class="text-center">
        <a href="<%= app.maps.url %>" target="_blank" class="btn btn-outline-primary">
          Lihat di Google Maps
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="text-center">
    <p>&copy; <%= new Date().getFullYear() %> <%= app.name %>. Semua Hak Dilindungi.</p>
  </footer>
</body>
</html>
