<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <!--begin::Primary Meta Tags-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="title" content="<%= app.name %> | Pendaftaran Online" />
    <meta name="author" content="<%= app.name %>" />
    <meta name="description"
        content="Pendaftaran online <%= app.name %>. Permudah pendaftaran pemeriksaan gigi, pilih jadwal, dan dapatkan pelayanan yang cepat serta nyaman." />
    <meta name="keywords"
        content="pendaftaran online, klinik gigi, dokter gigi, pemeriksaan gigi, <%= app.shortName %>, <%= app.name %>, booking dokter gigi" />
    <!--end::Primary Meta Tags-->

    <title>Pendaftaran Pasien</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <style>
        body {
            background: linear-gradient(135deg, #eef4ff, #f8fbff);
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            border-radius: 16px;
            border: none;
        }

        .form-control {
            border-radius: 10px;
        }

        .btn {
            border-radius: 10px;
        }

        .patient-box {
            background: #ffffff;
            border-radius: 14px;
            padding: 16px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .patient-header {
            font-weight: 600;
            color: #0d6efd;
            margin-bottom: 10px;
        }

        .patient-item {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            padding: 4px 0;
            border-bottom: 1px dashed #eee;
        }

        .patient-item:last-child {
            border-bottom: none;
        }

        .patient-label {
            color: #6c757d;
        }

        .patient-value {
            font-weight: 500;
            text-align: right;
        }

        .fade-in {
            animation: fadeIn .4s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }
    </style>

</head>

<body>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="card shadow">
                    <div class="card-body p-4">

                        <h5 class="text-center text-primary mb-4">Pendaftaran Pasien</h5>

                        <form id="formCek">

                            <div class="mb-3">
                                <label class="form-label small text-muted">Nomor Rekam Medis / NIK</label>
                                <input type="text" id="no_identitas" class="form-control"
                                    placeholder="Masukkan No RM atau NIK" name="no_identitas" autocomplete="on"
                                    required>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small text-muted">Tanggal Lahir</label>
                                <input type="date" id="tgl_lahir" class="form-control" name="bday" autocomplete="bday"
                                    required>
                            </div>

                            <button class="btn btn-primary w-100">
                                <span id="btnText">Cek Data</span>
                            </button>

                        </form>

                        <div class="text-center mt-3">
                            <small class="text-muted">
                                Belum punya No. Rekam Medis?
                            </small><br>
                            <a href="/register/new" class="fw-semibold text-decoration-none">
                                Daftar sebagai pasien baru
                            </a>
                        </div>

                        <div id="message" class="text-danger text-center mt-2 small"></div>

                        <div id="formLanjutan" class="d-none mt-3">

                            <input type="hidden" id="no_rkm_medis">

                            <!-- DATA DIRI BAGUS -->
                            <div class="patient-box mb-3 fade-in">
                                <div class="patient-header">Data Pasien</div>

                                <div class="patient-item">
                                    <span class="patient-label">Nama</span>
                                    <span class="patient-value" id="nm_pasien"></span>
                                </div>

                                <div class="patient-item">
                                    <span class="patient-label">No. RM</span>
                                    <span class="patient-value" id="show_rm"></span>
                                </div>

                                <div class="patient-item">
                                    <span class="patient-label">NIK</span>
                                    <span class="patient-value" id="show_nik"></span>
                                </div>

                                <div class="patient-item">
                                    <span class="patient-label">Jenis Kelamin</span>
                                    <span class="patient-value" id="jk"></span>
                                </div>

                                <div class="patient-item">
                                    <span class="patient-label">Tanggal Lahir</span>
                                    <span class="patient-value" id="show_tgl"></span>
                                </div>

                                <div class="patient-item">
                                    <span class="patient-label">No. HP</span>
                                    <span class="patient-value" id="show_hp"></span>
                                </div>

                                <div class="patient-item">
                                    <span class="patient-label">Alamat</span>
                                    <span class="patient-value" id="alamat"></span>
                                </div>
                            </div>

                            <label class="form-label small text-muted">Tanggal Periksa</label>
                            <input type="date" id="tgl_periksa" class="form-control mb-2">
                            <small id="info_libur" class="d-block mt-1"></small>
                            <label class="form-label small text-muted d-flex justify-content-center">Jadwal</label>
                            <div class="col-sm-12 mb-3 d-flex justify-content-center">
                                <div class="btn-group" id="queueSessionGroup" role="group" aria-label="Queue Sessions">
                                </div>
                            </div>
                            <label class="form-label small text-muted">Keluhan</label>
                            <textarea id="keluhan" class="form-control mb-2" placeholder="Keluhan"></textarea>

                            <button id="btnDaftar" class="btn btn-success w-100">
                                Daftar Sekarang
                            </button>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        const message = document.getElementById('message');
        const formLanjutan = document.getElementById('formLanjutan');
        const btnText = document.getElementById('btnText');
        const tglInput = document.getElementById('tgl_periksa');
        const btnDaftar = document.getElementById('btnDaftar');

        // elemen info libur (tambahkan di HTML di bawah input tanggal)
        const infoLibur = document.getElementById('info_libur');

        // set minimal tanggal = hari ini
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        tglInput.min = `${yyyy}-${mm}-${dd}`;

        // flag hari libur
        let isHariLibur = false;

        // cek hari libur saat tanggal berubah
        tglInput.addEventListener('change', async function () {
            const tanggal = this.value;
            if (!tanggal) return;

            isHariLibur = false;
            infoLibur.innerText = "";

            try {
                const res = await axios.get(`/api/holiday/${tanggal}`);
                if (res.data.data?.tanggal) {
                    isHariLibur = true;
                    infoLibur.innerText = "Tanggal yang dipilih adalah hari libur / klinik tutup";
                    infoLibur.classList.add('text-danger');
                } else {
                    infoLibur.innerText = "Tanggal tersedia untuk pemeriksaan";
                    infoLibur.classList.remove('text-danger');
                    infoLibur.classList.add('text-success');
                }
            } catch (err) {
                if (err.response?.status === 404) {
                    // Tidak ada data libur = tanggal tersedia
                    isHariLibur = false;
                    infoLibur.innerText = "Tanggal tersedia untuk pemeriksaan";
                    infoLibur.classList.remove('text-danger');
                    infoLibur.classList.add('text-success');
                } else {
                    console.error('Gagal cek hari libur:', err);
                    infoLibur.innerText = "Gagal mengecek hari libur";
                    infoLibur.classList.add('text-warning');
                }
            }

            validateTanggal();
            await loadQueueSessions(tanggal)
            updateRegisterButton();
        });

        // validasi tanggal pemeriksaan
        function validateTanggal() {
            const tanggal = tglInput.value;
            if (!tanggal) return false;

            const selectedDate = new Date(tanggal);
            selectedDate.setHours(0, 0, 0, 0);

            tglInput.classList.remove('is-valid', 'is-invalid');
            tglInput.setCustomValidity('');

            if (selectedDate < today) {
                tglInput.setCustomValidity('Tanggal sebelum hari ini');
                tglInput.classList.add('is-invalid');
                infoLibur.innerText = "Tanggal tidak boleh sebelum hari ini";
                infoLibur.classList.add('text-danger');
                return false;
            }

            if (isHariLibur) {
                tglInput.setCustomValidity('Hari libur');
                tglInput.classList.add('is-invalid');
                return false;
            }

            tglInput.classList.add('is-valid');
            return true;
        }

        // ==================== CEK PASIEN ====================
        document.getElementById('formCek').addEventListener('submit', async function (e) {
            e.preventDefault();

            const id = document.getElementById('no_identitas').value;
            const tglLahir = document.getElementById('tgl_lahir').value;

            btnText.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Loading...';
            message.innerText = "";

            try {
                const res = await axios.get('/api/patient/birth', {
                    params: { id, tglLahir }
                });

                const r = res.data;

                if (r.error || !r.data) {
                    message.innerText = "Data tidak ditemukan";
                    btnText.innerText = "Cek Data";
                    formLanjutan.classList.add('d-none');
                    return;
                }

                const p = r.data;

                document.getElementById('no_rkm_medis').value = p.no_rkm_medis;

                document.getElementById('nm_pasien').innerText = p.nama;
                document.getElementById('show_rm').innerText = p.no_rkm_medis;
                document.getElementById('show_nik').innerText = p.nik;
                document.getElementById('jk').innerText = p.jk === 'L' ? 'Laki-laki' : 'Perempuan';
                document.getElementById('show_tgl').innerText = p.tgl_lahir;
                document.getElementById('show_hp').innerText = p.nohp;
                document.getElementById('alamat').innerText = p.alamat;

                const today = new Date();
                const yyyy = today.getFullYear();
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const dd = String(today.getDate()).padStart(2, '0');

                document.getElementById('tgl_periksa').value = `${yyyy}-${mm}-${dd}`;
                tglInput.dispatchEvent(new Event('change'));

                formLanjutan.classList.remove('d-none');

                btnText.innerText = "Cek Data";

            } catch (err) {
                console.error(err);

                if (axios.isAxiosError(err)) {
                    if (err.response) {
                        if (err.response.status === 404) {
                            message.innerText = "Data tidak ditemukan";
                        } else {
                            message.innerText = err.response.data?.message || "Terjadi kesalahan server";
                        }
                    } else if (err.request) {
                        message.innerText = "Tidak ada respon dari server";
                    } else {
                        message.innerText = err.message;
                    }
                } else {
                    message.innerText = "Terjadi kesalahan tidak diketahui";
                }

                resetDetail();
            }
            btnText.innerText = "Cek Data";
        });

        // ==================== DAFTAR ====================
        document.getElementById('btnDaftar').addEventListener('click', async function () {

            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Proses...';

            const no_rkm_medis = document.getElementById('no_rkm_medis').value;
            const tgl_periksa = document.getElementById('tgl_periksa').value;
            const selectedQueueSession = document.querySelector('input[name="queue_session_id"]:checked')
            const keluhan = document.getElementById('keluhan').value;

            if (!validateTanggal()) {
                alert("Tanggal pemeriksaan tidak valid");
                btn.disabled = false;
                btn.innerText = "Daftar Sekarang";
                return;
            }

            if (!selectedQueueSession) {
                alert("Silakan pilih jadwal.");
                btn.disabled = false;
                btn.innerText = "Daftar Sekarang";
                return;
            }

            const schedule = Number(selectedQueueSession.value);

            try {
                const res = await axios.post('/api/register', {
                    no_rkm_medis,
                    tanggalDaftar: tgl_periksa,
                    schedule,
                    keluhan
                });

                if (!res.data.error) {
                    window.location.href = '/register/' + res.data.data.id;
                } else {
                    alert("Gagal daftar : " + res.data.message);
                }

            } catch (err) {
                console.log(err);

                let msg = 'Terjadi kesalahan saat pendaftaran.';

                if (axios.isAxiosError(err)) {
                    if (err.response) {
                        msg = err.response.data?.message || msg;
                    } else if (err.request) {
                        msg = 'Tidak ada respon dari server.';
                    } else {
                        msg = err.message;
                    }
                }

                alert(msg);
            }

            btn.disabled = false;
            btn.innerText = "Daftar Sekarang";
        });

        function resetDetail() {
            formLanjutan.classList.add('d-none');

            document.getElementById('no_rkm_medis').value = "";

            document.getElementById('nm_pasien').innerText = "";
            document.getElementById('show_rm').innerText = "";
            document.getElementById('show_nik').innerText = "";
            document.getElementById('jk').innerText = "";
            document.getElementById('show_tgl').innerText = "";
            document.getElementById('show_hp').innerText = "";
            document.getElementById('alamat').innerText = "";

            document.getElementById('tgl_periksa').value = "";
            document.getElementById('keluhan').value = "";
        }

        const loadQueueSessions = async (date) => {
            try {
                const response = await axios.get(`/api/schedules/active/${date}`);
                const sessions = response.data.data;

                const container = document.getElementById('queueSessionGroup');
                container.innerHTML = '';

                if (!sessions || sessions.length === 0) {
                    container.innerHTML = `
                        <div class="alert alert-warning w-100 text-center mb-0">
                            Tidak ada jadwal tersedia pada tanggal yang dipilih.
                        </div>
                    `;
                    return;
                }

                sessions.forEach((session, index) => {
                    const input = document.createElement('input');
                    input.type = 'radio';
                    input.className = 'btn-check';
                    input.name = 'queue_session_id';
                    input.id = `queue-session-${session.id}`;
                    input.value = session.id;
                    input.autocomplete = 'off';
                    input.required = true;

                    if (sessions.length === 1) {
                        input.checked = true;
                    }

                    const label = document.createElement('label');
                    label.className = 'btn btn-outline-success';
                    label.htmlFor = input.id;
                    label.textContent = `${session.start_time.slice(0, 5)} - ${session.end_time.slice(0, 5)}`;

                    container.appendChild(input);
                    container.appendChild(label);
                });
            } catch (error) {
                console.error(error);
            }
        }

        function updateRegisterButton() {
            const hasSchedule =
                document.querySelectorAll('input[name="queue_session_id"]').length > 0;

            btnDaftar.disabled = !validateTanggal() || !hasSchedule;
        }
    </script>

</body>

</html>