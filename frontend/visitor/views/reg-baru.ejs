<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Form Pemeriksaan Pasien</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background-color: #f8f9fa;
      padding: 2rem;
    }

    .form-title {
      font-weight: 600;
      color: #0d6efd;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .invalid-feedback {
      display: none;
    }

    select:invalid~.invalid-feedback,
    input:invalid~.invalid-feedback {
      display: block;
    }

    .btn-group.is-invalid .btn {
        border-color: #dc3545;
    }

    .btn-group.is-invalid + .invalid-feedback {
        display: block;
    }
  </style>
</head>

<body>
  <h4 class="form-title">Form Pemeriksaan Pasien</h4>
  <form id="formPasien" novalidate>

    <!-- Tanggal Pemeriksaan -->
    <div class="mb-3">
      <label for="tgl" class="form-label">Tanggal Pemeriksaan</label>
      <input type="date" class="form-control" id="tgl" required />
      <div class="invalid-feedback">Tanggal pemeriksaan tidak boleh sebelum hari ini.</div>
    </div>

    <div class="mb-3">
      <label class="form-label">Jadwal</label>
        <div class="col-sm-12 mb-3">
            <div class="btn-group"  id="queueSessionGroup" role="group" aria-label="Queue Sessions">
            </div>
        </div>
    </div>

    <!-- Nama -->
    <div class="mb-3">
      <label for="nama" class="form-label">Nama</label>
      <input type="text" class="form-control" id="nama" required placeholder="Masukkan nama lengkap" />
    </div>

    <!-- NIK -->
    <div class="mb-3">
      <label for="nik" class="form-label">NIK</label>
      <input type="text" class="form-control" id="nik" required placeholder="Masukkan NIK" />
    </div>

    <div class="mb-3">
      <label for="nohp" class="form-label">Nomor HP</label>
      <input type="tel" class="form-control" id="nohp" name="nohp" required placeholder="Contoh: 081234567890"
        pattern="^08[0-9]{8,11}$" />
      <div class="invalid-feedback">
        Nomor HP harus dimulai dengan 08 dan terdiri dari 10–13 digit angka.
      </div>
    </div>

    <!-- Alamat -->
    <div class="mb-3">
      <label for="alamat" class="form-label">Alamat</label>
      <textarea class="form-control" id="alamat" rows="2" required placeholder="Masukkan alamat lengkap"></textarea>
    </div>

    <!-- Jenis Kelamin -->
    <div class="mb-3">
      <label class="form-label">Jenis Kelamin</label>
      <div class="col-sm-12 mb-3">

        <div class="btn-group" role="group" aria-label="Jenis Kelamin">

          <input 
            type="radio" 
            class="btn-check" 
            name="jk" 
            id="jkL" 
            value="L"
            autocomplete="off"
            required>

          <label class="btn btn-outline-secondary" for="jkL">
            Laki-laki
          </label>


          <input 
            type="radio" 
            class="btn-check" 
            name="jk" 
            id="jkP" 
            value="P"
            autocomplete="off"
            required>

          <label class="btn btn-outline-secondary" for="jkP">
            Perempuan
          </label>

        </div>

        <div class="invalid-feedback" id="jkError">
          Pilih jenis kelamin terlebih dahulu.
        </div>
      </div>
    </div>

    <!-- Tanggal Lahir -->
    <div class="mb-3">
      <label class="form-label">Tanggal Lahir</label>
      <div class="row g-2">
        <div class="col-4">
          <select class="form-select" id="lahirTanggal" required>
            <option value="" disabled selected>Tanggal</option>
            <script>
              for (let i = 1; i <= 31; i++) {
                document.write(`<option value="${i}">${i}</option>`);
              }
            </script>
          </select>
        </div>
        <div class="col-4">
          <select class="form-select" id="lahirBulan" required>
            <option value="" disabled selected>Bulan</option>
            <option value="1">Januari</option>
            <option value="2">Februari</option>
            <option value="3">Maret</option>
            <option value="4">April</option>
            <option value="5">Mei</option>
            <option value="6">Juni</option>
            <option value="7">Juli</option>
            <option value="8">Agustus</option>
            <option value="9">September</option>
            <option value="10">Oktober</option>
            <option value="11">November</option>
            <option value="12">Desember</option>
          </select>
        </div>
        <div class="col-4">
          <select class="form-select" id="lahirTahun" required>
            <option value="" disabled selected>Tahun</option>
            <script>
              const thisYear = new Date().getFullYear();
              for (let i = thisYear; i >= 1900; i--) {
                document.write(`<option value="${i}">${i}</option>`);
              }
            </script>
          </select>
        </div>
      </div>
      <div class="invalid-feedback mt-1" id="lahirError">Tanggal lahir tidak valid.</div>
    </div>

    <!-- Keluhan -->
    <div class="mb-3">
      <label for="keluhan" class="form-label">Keluhan</label>
      <textarea class="form-control" id="keluhan" rows="3" required placeholder="Deskripsikan keluhan Anda"></textarea>
    </div>

    <!-- Tombol Submit -->
    <div class="d-grid">
      <button type="submit" class="btn btn-primary">Kirim</button>
    </div>
  </form>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
    // Set min date (today) for Tanggal Pemeriksaan
    const tglInput = document.getElementById('tgl')
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    const dd = String(today.getDate()).padStart(2, '0');
    tglInput.min = `${yyyy}-${mm}-${dd}`;

    //global var isLibur
    let isHariLibur = false

    loadQueueSessions()

    //cek hari libur (on change)
    tglInput.addEventListener('change', async function() {
      const tanggal = this.value
      if (!tanggal) return

      isHariLibur = false

      try {
        const res = await axios.get(`/api/holiday/${tanggal}`)
        if(res.data.data.tanggal) {
          isHariLibur = true
        }
      } catch (error) {
        console.error('Gagal cek hari libur:', error)
      }

      validateTanggalPemeriksaan()
    })

    document.getElementById('formPasien').addEventListener('submit', function (e) {
      e.preventDefault(); // Prevent form submission here

      let isValid = true;

      // --- VALIDATE TANGGAL LAHIR ---
      const tgl = parseInt(document.getElementById('lahirTanggal').value);
      const bln = parseInt(document.getElementById('lahirBulan').value) - 1;
      const thn = parseInt(document.getElementById('lahirTahun').value);
      const lahirError = document.getElementById('lahirError');

      if (!tgl || bln < 0 || !thn) {
        isValid = false;
        lahirError.style.display = 'block';
      } else {
        const d = new Date(thn, bln, tgl);
        if (
          d.getFullYear() !== thn ||
          d.getMonth() !== bln ||
          d.getDate() !== tgl
        ) {
          isValid = false;
          lahirError.style.display = 'block';
        } else {
          lahirError.style.display = 'none';
        }
      }

      if (!validateTanggalPemeriksaan()) {
        isValid = false;
      }

      if (!this.checkValidity() || !isValid) {
        e.stopPropagation(); // Prevent propagation if form is invalid
        this.classList.add('was-validated');
        return; // Stop further execution if form is invalid
      }

      // Get form data
      const nama = document.getElementById('nama').value;
      const nik = document.getElementById('nik').value;
      const nohp = document.getElementById('nohp').value;
      const alamat = document.getElementById('alamat').value;
      const jk = document.querySelector('input[name="jk"]:checked').value;
      const selectedQueueSession = document.querySelector('input[name="queue_session_id"]:checked')
      const tglLahir = `${document.getElementById('lahirTahun').value}-${String(document.getElementById('lahirBulan').value).padStart(2, '0')}-${String(document.getElementById('lahirTanggal').value).padStart(2, '0')}`;
      const tanggalDaftar = document.getElementById('tgl').value;
      const keluhan = document.getElementById('keluhan').value;

      if (!selectedQueueSession) {
          alert("Silakan pilih jadwal.");
          btn.disabled = false;
          btn.innerText = "Daftar Sekarang";
          return;
      }

      const queueSession = Number(selectedQueueSession.value);

      // Prepare data object for POST request
      const formData = {
        nama,
        nik,
        nohp,
        alamat,
        jk,
        tglLahir,
        tanggalDaftar,
        queueSession,
        keluhan,
      };

      // Send data to the server via Axios
      axios.post('/api/register/new', formData)
        .then((response) => {
          window.location.href = '/register/' + response.data.data.id; // Redirect after successful submission
        })
        .catch((error) => {
          alert(`Terjadi kesalahan saat pendaftaran. Silakan coba lagi. \n${error.response.data.message}`);
        })
    })

    function validateTanggalPemeriksaan() {
      const tanggal = tglInput.value
      if (!tanggal) return false

      const selectedDate = new Date(tanggal)
      selectedDate.setHours(0, 0, 0, 0)
      today.setHours(0, 0, 0, 0)

      // RESET STATE (INI KUNCI)
      tglInput.classList.remove('is-valid', 'is-invalid')
      tglInput.setCustomValidity('')

      if (selectedDate < today) {
        tglInput.setCustomValidity('Tanggal sebelum hari ini')
        tglInput.classList.add('is-invalid');
        tglInput.nextElementSibling.textContent =
            'Tanggal pemeriksaan tidak boleh sebelum hari ini.'
        return false;
      }

      if (isHariLibur) {
        tglInput.setCustomValidity('Hari libur')
        tglInput.classList.add('is-invalid')
        tglInput.nextElementSibling.textContent =
            'Tanggal tersebut tutup.'
        return false
      }

      tglInput.classList.add('is-valid')
      return true 
    }

    
  })

  const loadQueueSessions = async () => {
      try {
          const response = await axios.get('/api/queue-session/active');
          const sessions = response.data.data;

          const container = document.getElementById('queueSessionGroup');
          container.innerHTML = '';

          sessions.forEach((session, index) => {
              const input = document.createElement('input');
              input.type = 'radio';
              input.className = 'btn-check';
              input.name = 'queue_session_id';
              input.id = `queue-session-${session.id}`;
              input.value = session.id;
              input.autocomplete = 'off';
              input.required = true;

              if (sessions.length === 1) {
                  input.checked = true;
              }

              const label = document.createElement('label');
              label.className = 'btn btn-outline-secondary';
              label.htmlFor = input.id;
              label.textContent = `${session.start_time.slice(0, 5)} - ${session.end_time.slice(0, 5)}`;

              container.appendChild(input);
              container.appendChild(label);
          });
      } catch (error) {
          console.error(error);
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

</body>

</html>