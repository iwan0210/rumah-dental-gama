<%- include('partials/header') %>


  <!--begin::App Main-->
  <main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
      <!--begin::Container-->
      <div class="container-fluid">
        <div class="row">
          <div class="col-sm-6">
            <h3 class="mb-0">Pasien</h3>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-end">
              <li class="breadcrumb-item"><a href="#">Pasien</a></li>
              <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
          </div>
          <!--begin::Row-->
          <!--begin::table-->
          <div class="col-lg-12">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">Data Pasien</h3>
                <div class="card-tools">
                  <div class="input-group">
                    <input type="search" class="form-control" placeholder="Search" id="input-search" />
                    <button class="btn btn-primary" id="search-btn" type="button">Cari</button>
                  </div>
                </div>
              </div>
              <div class="card-body p-0">
                <div class="table-responsive">
                  <table class="table table-striped table-bordered">
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>No.RM</th>
                        <th>Nama</th>
                        <th>NIK</th>
                        <th>Jenis Kelamin</th>
                        <th>Tanggal Lahir</th>
                        <th>Alamat</th>
                        <th>Nomor Telepon</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody id="table-body">
                      <tr>
                        <td colspan="10" class="text-center">No Data Available.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="card-footer clearfix">
                <div id="page-info" class="float-start">
                  Page 1 of 1
                </div>
                <ul id="pagination" class="pagination pagination-sm m-0 float-end">
                  <li class="page-item"><a class="page-link" href="#">&laquo;</a></li>
                  <li class="page-item"><a class="page-link" href="#">1</a></li>
                  <li class="page-item"><a class="page-link" href="#">2</a></li>
                  <li class="page-item"><a class="page-link" href="#">3</a></li>
                  <li class="page-item"><a class="page-link" href="#">&raquo;</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <!--end::Row-->
      </div>
      <!--end::Container-->
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
      <!--begin::Container-->
      <div class="container-fluid">

      </div>
      <!--end::Container-->
    </div>
    <!--end::App Content-->
    <div class="modal fade" id="modal-merge" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">

          <div class="modal-header">
            <h5 class="modal-title">Gabung No.RM</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body">

            <!-- Data sumber -->
            <div class="mb-3">
              <label>No.RM Sumber</label>
              <input type="text" id="merge-source-rm" class="form-control" readonly>
            </div>

            <div class="mb-3">
              <label>Nama Sumber</label>
              <input type="text" id="merge-source-nama" class="form-control" disabled>
            </div>

            <hr>

            <!-- Input tujuan -->
            <div class="mb-3">
              <label>No.RM Tujuan</label>
              <div class="input-group">
                <input type="text" id="merge-target-rm" class="form-control">
                <button class="btn btn-primary" id="btn-check-rm">Cek</button>
              </div>
            </div>

            <!-- Hasil cek -->
            <div id="target-info" style="display:none;">
              <div class="mb-2">
                <label>Nama</label>
                <input type="text" id="target-nama" class="form-control" disabled>
              </div>
              <div class="mb-2">
                <label>NIK</label>
                <input type="text" id="target-nik" class="form-control" disabled>
              </div>
              <div class="mb-2">
                <label>Tanggal Lahir</label>
                <input type="text" id="target-tgl" class="form-control" disabled>
              </div>
              <div class="mb-2">
                <label>Jenis Kelamin</label>
                <input type="text" id="target-jk" class="form-control" disabled>
              </div>
              <div class="mb-2">
                <label>Alamat</label>
                <input type="text" id="target-alamat" class="form-control" disabled>
              </div>
            </div>

          </div>

          <div class="modal-footer">
            <button class="btn btn-success" id="btn-merge">Gabung</button>
          </div>

        </div>
      </div>
    </div>
  </main>
  <!--end::App Main-->

  <script>
    document.addEventListener('DOMContentLoaded', async () => {

      modal = new bootstrap.Modal(document.getElementById('modal-merge'))

      document.getElementById('modal-merge').addEventListener('shown.bs.modal', () => {
        document.getElementById('merge-target-rm').focus()
      })

      document.getElementById('merge-target-rm').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
          document.getElementById('btn-check-rm').click()
        }
      })
      document.getElementById('btn-check-rm').addEventListener('click', async () => {
        const targetRM = document.getElementById('merge-target-rm').value
        await checkTargetPatient(targetRM)
      })
      document.getElementById('btn-merge').addEventListener('click', async () => {
        const sourceRM = document.getElementById('merge-source-rm').value
        const targetRM = document.getElementById('merge-target-rm').value

        if (!sourceRM || !targetRM) {
          alert('Data belum lengkap')
          return
        }

        if (sourceRM === targetRM) {
          alert('Tidak bisa gabung ke No.RM yang sama')
          return
        }

        if (!confirm(`Gabungkan ${sourceRM} ke ${targetRM}?`)) return

        await doMergePatient(sourceRM, targetRM)
      })

      document.getElementById('search-btn').addEventListener('click', async () => {
        currentPage = 1
        await fetchSearchPatient(currentPage)
      })

      await fetchSearchPatient(currentPage)

    })
  </script>

  <%- include('partials/footer') %>