<%- include('partials/header') %>

    <!--begin::App Main-->
    <main class="app-main">
        <!--begin::App Content Header-->
        <div class="app-content-header">
            <!--begin::Container-->
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Tambah Data</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item"><a href="#">Tambah Data</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                        </ol>
                    </div>

                    <!--begin::table-->
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Tambah Data Registrasi</h3>
                            </div>
                            <div class="card-body p-0 m-3">
                                <form id="add-data-form">
                                    <div class="row">
                                        <div class="col-sm-6 mb-3">
                                            <label for="name" class="form-label">No. RM</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control" id="no_rkm_medis"
                                                    placeholder="Nomor Rekam Medis" required readonly>
                                                <button class="btn btn-secondary" id="norm-btn" type="button"
                                                    onclick="openModalPasien()">Cari pasien</button>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="name" class="form-label">Nama</label>
                                            <input type="text" class="form-control" id="name" placeholder="Nama"
                                                disabled>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="nik" class="form-label">NIK</label>
                                            <input type="text" class="form-control" id="nik" placeholder="NIK" disabled>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="alamat" class="form-label">Alamat</label>
                                            <input type="text" class="form-control" id="alamat" placeholder="Alamat"
                                                disabled>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="telepon" class="form-label">Nomor Telepon</label>
                                            <input type="text" class="form-control" id="telepon"
                                                placeholder="Nomor Telepon" disabled>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="tanggal-lahir" class="form-label">Tanggal Lahir</label>
                                            <input type="date" class="form-control" id="tanggal-lahir" disabled>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="jenis-kelamin" class="form-label">Jenis Kelamin</label>
                                            <input type="text" class="form-control" id="jenis-kelamin"
                                                placeholder="Jenis Kelamin" disabled>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="tanggal-periksa" class="form-label">Tanggal Periksa</label>
                                            <div class="input-group">
                                                <input type="date" class="form-control" id="tanggal-periksa">
                                                <button class="btn btn-secondary" id="today-btn" type="button"
                                                    onclick="today()">Hari Ini</button>
                                            </div>
                                        </div>
                                        <label class="form-label d-flex justify-content-center">Jadwal</label>
                                        <div class="col-sm-12 mb-3 d-flex justify-content-center">
                                            <div class="btn-group" id="queueSessionGroup" role="group"
                                                aria-label="Queue Sessions">
                                                <div class="alert alert-warning w-100 text-center mb-0">
                                                    Silahkan pilih tanggal terlebih dahulu.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="keluhan" class="form-label">Keluhan</label>
                                            <textarea class="form-control" id="keluhan" rows="3" placeholder="Keluhan"
                                                required></textarea>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="diagnosa" class="form-label">Diagnosa</label>
                                            <textarea class="form-control" id="diagnosa" rows="3"
                                                placeholder="Diagnosa"></textarea>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="tindakan" class="form-label">Tindakan</label>
                                            <textarea class="form-control" id="tindakan" rows="3"
                                                placeholder="Tindakan"></textarea>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="obat" class="form-label">obat</label>
                                            <textarea class="form-control" id="obat" rows="3"
                                                placeholder="Obat"></textarea>
                                        </div>
                                        <div class="col-sm-6 mb-3">
                                            <label for="biaya" class="form-label">Biaya</label>
                                            <div class="input-group">
                                                <span class="input-group-text">Rp</span>
                                                <input type="text" class="form-control no-arrows" id="biaya"
                                                    placeholder="Biaya" required>
                                            </div>

                                        </div>
                                </form>
                            </div>
                            <div class="card-footer clearfix">
                                <div class="float-start">
                                    <Button class="btn btn-danger" onclick="clearForm()">Kosongkan</Button>
                                    <Button class="btn btn-primary" type="submit" form="add-data-form">Simpan</Button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::table-->

                </div>
                <!--end::Row-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::App Content Header-->
        <!--begin::App Content-->
        <div class="app-content">
            <!--begin::Container-->
            <div class="container-fluid">

            </div>
            <!--end::Container-->
        </div>
        <!--end::App Content-->
        <!-- Modal Cari Pasien -->
        <div class="modal fade" id="modalPasien" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cari Pasien</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <input type="text" id="search-pasien" class="form-control mb-3"
                            placeholder="Cari nama / NIK / alamat">

                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Aksi</th>
                                        <th>No RM</th>
                                        <th>Nama</th>
                                        <th>NIK</th>
                                        <th>JK</th>
                                        <th>Tgl Lahir</th>
                                        <th>No HP</th>
                                        <th>Alamat</th>
                                    </tr>
                                </thead>
                                <tbody id="result-pasien"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <!--end::App Main-->

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputBiaya = document.getElementById('biaya')

            inputBiaya.addEventListener('input', e => {
                let value = e.target.value.replace(/[^\d]/g, '');  // Remove non-numeric characters
                if (value) {
                    // Format with commas as the user types
                    e.target.value = new Intl.NumberFormat('id-ID').format(value);
                }
            })

            document.getElementById('add-data-form').addEventListener('submit', e => {
                e.preventDefault()

                insertData()
            })

            modal = new bootstrap.Modal(document.getElementById('modalPasien'))
            const searchInput = document.getElementById('search-pasien')

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer)

                debounceTimer = setTimeout(() => {
                    fetchPasien(this.value)
                }, 400)
            })

            // 🔥 BONUS 1: abort request saat modal ditutup
            document.getElementById('modalPasien').addEventListener('hidden.bs.modal', () => {
                if (currentController) {
                    currentController.abort()
                }
            })

            const tanggalPeriksa = document.getElementById('tanggal-periksa')

            tanggalPeriksa.addEventListener('change', (e) => {
                loadSchedule(e.target.value);
            })

            //loadSchedule(tanggalPeriksa.value)
        })

    </script>

    <%- include('partials/footer') %>